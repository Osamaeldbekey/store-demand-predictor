# ===========================================================================
# Data & trained artifacts — large, regenerable, never committed
# ===========================================================================
data/raw/*
data/processed/*
models/*
!data/raw/.gitkeep
!data/processed/.gitkeep
!models/.gitkeep

# ===========================================================================
# Python
# ===========================================================================
.venv/
venv/
env/
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
dist/
build/

# ===========================================================================
# Notebooks & environments
# ===========================================================================
.ipynb_checkpoints/
.env
.env.*
!.env.example

# ===========================================================================
# IDEs & OS
# ===========================================================================
.vscode/
.idea/
Thumbs.db
.DS_Store
desktop.ini

# ===========================================================================
# Safety net — artifact file types wherever they are written
# (the Kaggle zip, parquet/features caches, pickled models)
# ===========================================================================
*.joblib
*.parquet
*.zip

# ===========================================================================
# Deployment exceptions — artifacts deliberately shipped so a hosted
# deployment can serve real data without running the Kaggle pipeline.
# These MUST come last: git applies the final matching rule, so the
# negations have to follow the "safety net" above to take effect.
# ===========================================================================
!models/lgbm_v1.joblib
!data/processed/features.parquet
!data/processed/forecasts.parquet
!data/raw/holidays_events.csv

